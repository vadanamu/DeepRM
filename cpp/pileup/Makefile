# deeprm_pileup: C++ port of `deeprm call pileup`. Build: make -j$(nproc). Output: bin/deeprm_pileup
TOOLSET ?=	/opt/rh/gcc-toolset-14/root/usr/bin
ifneq ($(wildcard $(TOOLSET)/g++),)
	CC :=	$(TOOLSET)/gcc
	CXX :=	$(TOOLSET)/g++
endif
CCVER =		-std=c++23
# -ffp-contract=off: the sums must match NumPy bit for bit, so no fused multiply-add may be introduced
CXXFLAGS =	-g -O2 -Wall -Wextra -Wpedantic -ffp-contract=off -mavx2 -mfma
LD =		$(CXX)
# The C++ runtime is linked statically, so the program needs from the system only the C library and zlib;
# with Z_LIB=-l:libz.a only the C library (as the deeprm_preprocess shipped with DeepRM). EXTRA_LDFLAGS: for
# example a -specs file that keeps a toolchain's library folder out of the program's search path.
LFLAGS =	-static-libstdc++ -static-libgcc -Wl,--as-needed $(EXTRA_LDFLAGS)
PROG =		bin/deeprm_pileup
INCLUDES =	-I. -Ihtslib
LIBA =		htslib/libhts.a libdeflate/build/libdeflate.a
# zlib: htslib needs it for plain gzip and CRAM; BAM (BGZF) goes through libdeflate
Z_LIB ?=	-lz
LIBS =		$(Z_LIB) -lpthread
SRCS =		$(wildcard pileup/*.cc)
# SVML routines NumPy uses for float32 log2 and log10 (BSD-3-Clause, see svml/README.md)
SVML_SRCS =	$(wildcard svml/*.s)
OBJS =		$(patsubst %.cc,build/%.o,$(SRCS)) $(patsubst %.s,build/%.o,$(SVML_SRCS))
# unit tests: make test
TEST_PROG =	bin/unit_tests
TEST_SRCS =	$(wildcard tests/unit/*.cc)
TEST_OBJS =	$(patsubst %.cc,build/%.o,$(TEST_SRCS)) $(filter-out build/pileup/main.o,$(OBJS))

# for --version: "*" after the commit marks a tree with changes
GIT_HASH :=	$(shell git rev-parse --short HEAD 2>/dev/null || echo unknown)$(if $(shell git status -s 2>/dev/null),*)
BUILD_TIME :=	$(shell date -Iseconds)

.PHONY: all test clean clean_all FORCE

all: $(PROG)

$(PROG): $(OBJS) $(LIBA)
	mkdir -p bin
	$(LD) $(LFLAGS) $(OBJS) -o $@ $(LIBA) $(LIBS)

test: $(TEST_PROG)
	$(TEST_PROG)

$(TEST_PROG): $(TEST_OBJS) $(LIBA)
	mkdir -p bin
	$(LD) $(LFLAGS) $(TEST_OBJS) -o $@ $(LIBA) $(LIBS)

build/%.o: %.cc | $(LIBA) pileup/build_time.h
	mkdir -p $(dir $@)
	$(CXX) -c $(CCVER) $(CXXFLAGS) $(INCLUDES) -MMD -MP $< -o $@

# the one file that may use SIMD intrinsics: it calls the SVML routines
build/pileup/svml_call.o: CXXFLAGS += -mavx512f

build/svml/%.o: svml/%.s
	mkdir -p $(dir $@)
	$(CC) -c $< -o $@

# only version.cc includes the build time
build/pileup/version.o: pileup/build_time.h

# rewritten when the git state or a source changes, so an unchanged tree is not rebuilt
pileup/build_time.h: FORCE
	@if [ ! -f $@ ] || ! grep -q -F 'DEEPRM_GIT_HASH "$(GIT_HASH)"' $@ || \
		[ -n "$$(find Makefile pileup svml tests/unit -newer $@ ! -name build_time.h \
			\( -name Makefile -o -name '*.cc' -o -name '*.h' -o -name '*.s' \) | head -1)" ]; then \
		printf '%s\n' '// this file is generated by make' '#ifndef DEEPRM_PILEUP_BUILD_TIME_H_' \
			'#define DEEPRM_PILEUP_BUILD_TIME_H_' '#define DEEPRM_BUILD_TIME "$(BUILD_TIME)"' \
			'#define DEEPRM_GIT_HASH "$(GIT_HASH)"' '#endif  // DEEPRM_PILEUP_BUILD_TIME_H_' > $@; \
	fi

# The sources of the two libraries are taken as they are when they are there (a copy of the release, or a
# clone from GitHub: see BUILD.md); only an empty folder is filled from the submodule.
libdeflate/build/libdeflate.a:
	[ -e libdeflate/CMakeLists.txt ] || git submodule update --init libdeflate
	cmake -S libdeflate -B libdeflate/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=$(CC) \
		-DLIBDEFLATE_BUILD_SHARED_LIB=OFF -DLIBDEFLATE_BUILD_GZIP=OFF
	$(MAKE) -C libdeflate/build

# htslib with libdeflate for BGZF; as a submodule, its htscodecs comes from where htslib comes from. The libdeflate
# paths are relative to htslib/ (where it is built): htslib keeps its build flags in the library, and so in the program.
HTSCODECS_URL =	$(dir $(shell git config -f .gitmodules submodule.htslib.url 2>/dev/null))htscodecs.git
# htslib writes this header from git; a copy of the sources without git needs it written here
HTSCODECS_VERSION_H =	htslib/htscodecs/htscodecs/version.h
htslib/libhts.a: libdeflate/build/libdeflate.a
	[ -e htslib/configure.ac ] || git submodule update --init htslib
	[ -e htslib/htscodecs/configure.ac ] || { git -C htslib config submodule.htscodecs.url $(HTSCODECS_URL) && \
		git -C htslib submodule update --init; }
	[ -e htslib/htscodecs/.git ] || [ -e $(HTSCODECS_VERSION_H) ] || \
		sed -n 's/^AC_INIT(htscodecs, *\([0-9.]*\).*/#define HTSCODECS_VERSION_TEXT "\1"/p' \
			htslib/htscodecs/configure.ac > $(HTSCODECS_VERSION_H)
	cd htslib && autoreconf -i && ./configure CC=$(CC) --with-libdeflate --disable-bz2 --disable-lzma \
		--disable-libcurl --disable-plugins --disable-gcs --disable-s3 --disable-ref-cache \
		CPPFLAGS=-I../libdeflate LDFLAGS=-L../libdeflate/build
	$(MAKE) -C htslib lib-static

clean:
	rm -rf build bin pileup/build_time.h

clean_all: clean
	rm -rf libdeflate/build
	-$(MAKE) -C htslib distclean

-include $(patsubst %.cc,build/%.d,$(SRCS) $(TEST_SRCS))
